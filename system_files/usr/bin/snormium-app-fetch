#!/usr/bin/env bash
# Fetch, verify (SHA256 from packages/appimage.list) and install an AppImage into ~/.local/snormium/apps.
# Refuses to install anything whose hash is not pinned. Never runs as root.
set -Eeuo pipefail
[[ $EUID -ne 0 ]] || { echo "Do not run as root."; exit 1; }
LIST=/usr/share/snormium/appimage.list; APPDIR="$HOME/.local/snormium/apps"; DESK="$HOME/.local/share/applications"
mkdir -p "$APPDIR" "$DESK"
usage() { echo "usage: snormium-app-fetch {install|run|remove|list} <name>"; exit 2; }
cmd="${1:-}"; name="${2:-}"
entry() { grep -vE '^\s*(#|$)' "$LIST" | awk -v n="$name" '$1==n{print $2, $3}'; }
case "$cmd" in
  list) grep -vE '^\s*(#|$)' "$LIST" | awk '{printf "%-20s %s\n",$1,($3 ~ /^0+$/ ? "(not pinned — unavailable)" : "available")}' ;;
  install)
    read -r url sha < <(entry) || true
    [[ -n "${url:-}" ]] || { echo "Unknown app: $name" >&2; exit 1; }
    [[ "$sha" =~ ^0+$ ]] && { echo "$name has no pinned checksum in this release; refusing to install unverified software." >&2; exit 3; }
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    echo "Downloading $name..."; curl -fL --retry 3 -o "$tmp/app" "$url"
    echo "$sha  $tmp/app" | sha256sum -c --quiet || { echo "Checksum mismatch for $name — download discarded." >&2; exit 4; }
    install -m755 "$tmp/app" "$APPDIR/$name.AppImage"
    cat > "$DESK/snormium-$name.desktop" <<D
[Desktop Entry]
Name=$name
Exec=$APPDIR/$name.AppImage
Icon=$name
Type=Application
Categories=Game;Emulator;
D
    echo "Installed $name (verified)." ;;
  run) [[ -x "$APPDIR/$name.AppImage" ]] || "$0" install "$name"; exec "$APPDIR/$name.AppImage" ;;
  remove) rm -f "$APPDIR/$name.AppImage" "$DESK/snormium-$name.desktop"; echo "Removed $name." ;;
  *) usage ;;
esac
