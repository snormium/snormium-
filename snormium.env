# Snormium 2.0 image parameters (sourced by Justfile, build.sh and CI)
IMAGE_NAME=snormium
IMAGE_VARIANT=stable                      # bazzite tag: stable | testing
BASE_IMAGE=ghcr.io/ublue-os/bazzite       # AMD/Intel desktop (KDE Plasma, Wayland)
BASE_IMAGE_NVIDIA=ghcr.io/ublue-os/bazzite-nvidia-open
REPO_ORGANIZATION=snormium                # GitHub user/org that publishes the image (create it: github.com/snormium)
IMAGE_DESC="Snormium 2.0 — secure, easy desktop & gaming OS built on Bazzite"
IMAGE_KEYWORDS="bootc,bazzite,gaming,emulation,desktop"
DEFAULT_TAG=latest
BIB_IMAGE=quay.io/centos-bootc/bootc-image-builder:latest
DISTRO_NAME="Snormium"
DISTRO_VERSION="2.0"
DISTRO_CODENAME="isotope"
DISTRO_HOME_URL="https://github.com/snormium/snormium-"
